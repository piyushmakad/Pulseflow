# PulseFlow Environment Configuration
# Copy to .env and adjust values as needed.

# HTTP Server
HTTP_PORT=8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_MAX_BODY_BYTES=1048576

# PostgreSQL
DATABASE_URL=postgres://postgres:abcd1234@localhost:5432/pulseflow?sslmode=disable
DATABASE_MAX_CONN=25

# Redis
REDIS_URL=redis://localhost:6379/0
API_KEY_CACHE_TTL=60s

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_EVENTS_TOPIC=events.ingested
KAFKA_DEADLETTER_TOPIC=events.deadletter
KAFKA_CONSUMER_GROUP=pulseflow-workers
KAFKA_CONSUMER_RETRY=1s

# Outbox Relay
OUTBOX_POLL_INTERVAL=500ms
OUTBOX_BATCH_SIZE=100
OUTBOX_LEASE=30s
OUTBOX_RETRY_DELAY=5s

# Worker Pools
WEBHOOK_WORKER_COUNT=20
WEBHOOK_BUFFER_SIZE=200
WEBHOOK_TIMEOUT=30s
EMAIL_WORKER_COUNT=5
EMAIL_BUFFER_SIZE=50
EMAIL_TIMEOUT=10s
DELIVERY_POLL_INTERVAL=250ms
DELIVERY_BATCH_SIZE=50
DELIVERY_LEASE=10m
DELIVERY_RECOVERY_INTERVAL=5s
DELIVERY_FINALIZE_INTERVAL=5s
DELIVERY_PERSISTENCE_TIMEOUT=5s

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60s

# Retry Policy
RETRY_MAX_ATTEMPTS=5
RETRY_BASE_DELAY=1s
RETRY_MAX_DELAY=15m

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Graceful Shutdown
SHUTDOWN_TIMEOUT=30s
