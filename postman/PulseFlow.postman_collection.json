{
  "info": {
    "_postman_id": "b1038660-dbb4-45ab-9d25-33d65ae5f33a",
    "name": "PulseFlow API",
    "description": "Executable API verification for PulseFlow. Run the collection in order to validate health, authentication, event ingestion, lookup, idempotent replay, and idempotency conflicts.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{api_key}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Response is JSON', function () {",
          "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Liveness",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/healthz",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "healthz"
              ]
            },
            "description": "Checks whether the API process is alive. This endpoint deliberately does not query dependencies."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Liveness returns 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Process reports alive', function () {",
                  "    pm.expect(pm.response.json().status).to.eql('alive');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Readiness",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/readyz",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "readyz"
              ]
            },
            "description": "Checks PostgreSQL and Redis. PostgreSQL failure returns 503; Redis failure reports degraded while keeping HTTP 200."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Readiness returns 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('PostgreSQL is ready', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.checks.postgres).to.eql('ok');",
                  "    pm.expect(['ready', 'degraded']).to.include(body.status);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Reject Invalid API Key",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "pf_live_invalid",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "invalid-auth-check"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"security.test\",\n  \"data\": {\n    \"source\": \"postman\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/v1/events",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "events"
              ]
            },
            "description": "Proves an invalid PulseFlow API key cannot ingest an event."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Invalid key returns 401', function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test('Error code is unauthorized', function () {",
                  "    pm.expect(pm.response.json().error.code).to.eql('unauthorized');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Events",
      "item": [
        {
          "name": "Create Event",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{idempotency_key}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"order.created\",\n  \"data\": {\n    \"order_id\": \"{{order_id}}\",\n    \"total\": 4999,\n    \"source\": \"postman\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/v1/events",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "events"
              ]
            },
            "description": "Creates a new event and its outbox entry atomically. The pre-request script generates fresh test identifiers."
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = `${Date.now()}-${Math.random().toString(16).slice(2)}`;",
                  "pm.environment.set('idempotency_key', `postman-order-${suffix}`);",
                  "pm.environment.set('order_id', `order-${suffix}`);",
                  "pm.environment.unset('event_id');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('New event returns 202', function () {",
                  "    pm.response.to.have.status(202);",
                  "});",
                  "",
                  "pm.test('Event is accepted and newly created', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.created).to.eql(true);",
                  "    pm.expect(body.data.id).to.be.a('string').and.not.empty;",
                  "    pm.expect(body.data.type).to.eql('order.created');",
                  "    pm.expect(body.data.status).to.eql('accepted');",
                  "    pm.environment.set('event_id', body.data.id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Event",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/events/{{event_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "events",
                "{{event_id}}"
              ]
            },
            "description": "Reads the event using tenant-scoped authentication."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Event lookup returns 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Lookup returns the created event', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.data.id).to.eql(pm.environment.get('event_id'));",
                  "    pm.expect(body.data.type).to.eql('order.created');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Replay Same Event",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{idempotency_key}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"order.created\",\n  \"data\": {\n    \"order_id\": \"{{order_id}}\",\n    \"total\": 4999,\n    \"source\": \"postman\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/v1/events",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "events"
              ]
            },
            "description": "Replays the exact same tenant, key, type, and data. PulseFlow returns the existing event instead of creating another row."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Idempotent replay returns 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Replay returns the same event', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.created).to.eql(false);",
                  "    pm.expect(body.data.id).to.eql(pm.environment.get('event_id'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject Idempotency Conflict",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{idempotency_key}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"order.created\",\n  \"data\": {\n    \"order_id\": \"{{order_id}}-different\",\n    \"total\": 9999,\n    \"source\": \"postman\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/v1/events",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "events"
              ]
            },
            "description": "Reuses the idempotency key with different event content. This must be rejected instead of silently returning unrelated data."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Conflicting replay returns 409', function () {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "",
                  "pm.test('Error code identifies idempotency conflict', function () {",
                  "    pm.expect(pm.response.json().error.code).to.eql('idempotency_conflict');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
